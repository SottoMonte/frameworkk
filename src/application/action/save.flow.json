pipe:test(data) := validate(keys=[
  "username",
  "password"
]) 
  | retry(action=[load(table="users", query="$input.username")
], attempts=3) 
  | switch(val="$output", cases={is_null: [catch(fallback=[respond_error(msg="Non trovato")
    ])
  ], default: [pipe(check_password, generate_token, set(key="token"))
  ]
}) 
  | select(path="@token")


{
  "flow_name": "Login_Functional_Expression",
  "input_source": "user_credentials",
  "flow_sequence": [
    // 1. VALIDAZIONE: Assicura la presenza di username/password
    {
      "primitive": "validate",
      "args": [
        "has_required_keys",
        "$input"
      ],
      "kwargs": {
        "required_keys": [
          "username",
          "password"
        ]
      }
    },
    // 2. RESILIENZA & CARICAMENTO: Retry su load (output precedente è l'input implicito)
    {
      "primitive": "retry",
      "kwargs": {
        "attempts": 3
      },
      "action": {
        "func": "flow.load",
        "args": [
          "table=users"
        ],
        "kwargs": {
          "query": "$input.username"
        }
      }
    },
    // 3. CONTROLLO DI FLUSSO: Switch (valuta l'output del retry/load)
    {
      "primitive": "switch",
      "value": "$output",
      "cases": {
        // Se il record utente è nullo (caso is_null)
        "is_null": {
          "primitive": "catch",
          "action": {
            "func": "flow.respond_error",
            "kwargs": {
              "msg": "Utente non trovato",
              "http_code": 404
            }
          }
        },
        // Se l'utente è trovato (caso di default)
        "default": {
          "primitive": "pipe",
          "stages": [
            {
              "func": "flow.check_password",
              "args": [
                "$input",
                "$output"
              ]
            },
            {
              "func": "flow.generate_token",
              "args": [
                "$output.user_id"
              ]
            },
            {
              "func": "flow.set",
              "args": [
                "token"
              ],
              "value": "$output"
            }
          ]
        }
      }
    },
    // 4. RISULTATO FINALE: Estrae il token salvato dal contesto
    {
      "func": "flow.select",
      "path": "@token"
    }
  ]
}